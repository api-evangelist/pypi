                "packages",
                ":package",
                "recent"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Filter to a specific time period. If omitted, returns all three periods."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
