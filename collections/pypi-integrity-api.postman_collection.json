      "name": "Provenance",
      "description": {
        "content": "Retrieve digital attestations and provenance information for Python package distribution files hosted on PyPI.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d7632716-a81f-4891-a500-effd8ce764b5",
          "name": "Get file provenance",
          "request": {
            "name": "Get file provenance",
            "description": {
              "content": "Returns the provenance object for the given distribution filename. The provenance object contains one or more attestation bundles verified by PyPI, along with the Trusted Publisher identity that produced them. This endpoint implements PEP 740 and is currently available in JSON format only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "integrity",
                ":project",
                ":version",
                ":filename",
                "provenance"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "project",
                  "description": "(Required) The normalized name of the Python package on PyPI."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "version",
                  "description": "(Required) The version string of the release."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "filename",
                  "description": "(Required) The exact filename of the distribution file to retrieve provenance for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.pypi.integrity.v1+json"
              }
            ],
            "method": "GET",
            "auth": null
