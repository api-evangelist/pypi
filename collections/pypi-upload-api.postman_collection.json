      "id": "ad23936d-646f-43de-a713-e023ce3c568f",
      "name": "Upload",
      "description": {
        "content": "Upload Python package distributions to the Python Package Index.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "888fccc7-eba0-4937-ac1c-c790b9758f15",
          "name": "Upload a distribution file",
          "request": {
            "name": "Upload a distribution file",
            "description": {
              "content": "Uploads a Python package distribution file (source distribution or wheel) to PyPI. The request must use multipart/form-data encoding and include the distribution file as the content part along with package metadata as form fields. Authentication is required via HTTP Basic Auth using the username __token__ and an API token as the password, or via a short-lived token obtained through Trusted Publishing. PEP 740 attestations may optionally be attached for supply chain integrity verification.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "legacy",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": ":action",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The upload action type. Must be file_upload. (This can only be one of file_upload)"
                },
                {
                  "key": "content",
                  "type": "file",
                  "description": "(Required) The distribution file to upload, sent as application/octet-stream."
                },
                {
                  "key": "filetype",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The type of distribution being uploaded. (This can only be one of sdist,bdist_wheel,bdist_egg)"
                },
                {
                  "key": "name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The name of the Python package being uploaded."
                },
                {
                  "key": "version",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The version string of the release being uploaded."
                },
                {
                  "key": "metadata_version",
                  "value": "<string>",
                  "type": "text",
                  "description": "The version of the metadata standard used."
                },
                {
                  "key": "summary",
                  "value": "<string>",
                  "type": "text",
                  "description": "A one-line summary of the package."
                },
                {
                  "key": "description",
                  "value": "<string>",
                  "type": "text",
                  "description": "The full description of the package."
                },
                {
                  "key": "description_content_type",
                  "value": "<string>",
                  "type": "text",
                  "description": "The content type of the description, such as text/markdown."
                },
                {
                  "key": "author",
                  "value": "<string>",
                  "type": "text",
                  "description": "The name of the package author."
                },
                {
                  "key": "author_email",
                  "value": "<string>",
                  "type": "text",
                  "description": "The email address of the package author."
                },
                {
                  "key": "license",
                  "value": "<string>",
                  "type": "text",
                  "description": "The license text or identifier for the package."
                },
                {
                  "key": "keywords",
                  "value": "<string>",
                  "type": "text",
                  "description": "Comma-separated keywords for the package."
                },
                {
                  "key": "classifiers",
                  "value": "[\"<string>\",\"<string>\"]",
                  "type": "text",
                  "description": "Trove classifiers for the package. Multiple values are sent as repeated form fields."
                },
                {
                  "key": "home_page",
                  "value": "<uri>",
                  "type": "text",
                  "description": "The URL of the package home page."
                },
                {
                  "key": "requires_python",
                  "value": "<string>",
                  "type": "text",
                  "description": "The Python version requirement specifier."
                },
                {
